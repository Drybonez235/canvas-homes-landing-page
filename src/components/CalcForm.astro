---
import "../styles/global.css";
---

<section id="canvas-homes-form" class="relative">
  <div
    class="relative flex items-center justify-center min-h-screen bg-[hsl(var(--lightAccent-hsl))] p-6 font-sans"
  >
    <!-- Logo placed in the upper-left viewport corner -->
    <a href="/" class="absolute top-6 left-6 md:top-10 md:left-10 z-10">
      <img 
        src="/favicon.svg" 
        alt="Canvas Homes Logo" 
        class="w-12 h-12 md:w-36 md:h-36 object-contain" 
      />
    </a>

    <!-- Hidden iframe prevents page redirection on submission -->
    <iframe name="hidden_google_iframe" id="hidden_google_iframe" class="hidden"></iframe>
    <div class="relative w-full max-w-xl bg-[hsl(var(--white-hsl))] rounded-2xl p-8 md:p-10 shadow-xl border border-black/5">
      
      <!-- Progress Bar -->
      <div id="progressContainer" class="w-full h-1.5 bg-black/10 rounded-full mb-8 overflow-hidden">
        <div id="progressBar" class="h-full w-0 bg-[hsl(var(--accent-hsl))] transition-all duration-300 ease-out"></div>
      </div>

      <!-- Form Endpoint -->
      <form 
        id="interactiveForm"
        action="https://docs.google.com/forms/u/0/d/18re9-2qvNMEAnXrlnHyYXM3TEAdmo31MOv5y-GvU1V8/formResponse" 
        method="POST" 
        target="hidden_google_iframe"
      >

        <!-- Step 1: Name & Inline Captcha -->
        <div class="step-card active" data-step="7">
          <span
            class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent-hsl))]"
            >Question 7 of 8</span
          >
          <h2
            class="font-heading text-2xl md:text-3xl font-semibold text-[hsl(var(--darkAccent-hsl))] mt-2 mb-6"
          >
            Final Step!
          </h2>

          <div class="flex flex-col gap-5">
            <!-- Name Field -->
            <div>
              <label
                for="name"
                class="block text-xs font-semibold text-[hsl(var(--darkAccent-hsl))] mb-1.5"
              >
                What is your name?
              </label>
              <input
                type="text"
                id="name"
                name="entry.22027902"
                autocomplete="name"
                class="w-full px-5 py-4 text-base rounded-xl border-2 border-black/10 bg-slate-50 focus:bg-white focus:border-[hsl(var(--accent-hsl))] outline-none transition-colors"
                placeholder="Type your name..."
                required
              />
            </div>

            <!-- Inline Captcha Field -->
            <div>
              <label
                for="captcha"
                class="block text-xs font-semibold text-[hsl(var(--darkAccent-hsl))] mb-1.5"
              >
                reCAPTCHA
              </label>

              <!-- Inline Image + Input Container -->
              <div class="flex items-center gap-3">
                <div
                  class="shrink-0 flex items-center justify-center p-2 bg-slate-100 border-2 border-black/10 rounded-xl"
                >
                  <img
                    src="/recaptcha.png"
                    alt="Captcha Question"
                    class="h-10 w-auto object-contain select-none"
                  />
                  <p>Ten + one = ?</p>
                </div>
                <input
                  type="text"
                  id="captcha"
                  name="entry.1825806017"
                  autocomplete="off"
                  class="grow pl-2 py-4 text-base rounded-xl border-2 border-black/10 bg-slate-50 focus:bg-white focus:border-[hsl(var(--accent-hsl))] outline-none transition-colors"
                  placeholder="CAPTCHA Answer"
                  required
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2: Phone -->
        <div class="step-card hidden" data-step="6">
          <span class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent-hsl))]">Question 6 of 8</span>
          <h2 class="font-heading text-2xl md:text-3xl font-semibold text-[hsl(var(--darkAccent-hsl))] mt-2 mb-6">What is your phone number?</h2>
          <input 
            type="tel" 
            id="tel"
            name="entry.214765654" 
            autocomplete="tel"
            class="w-full px-5 py-4 text-base rounded-xl border-2 border-black/10 bg-slate-50 focus:bg-white focus:border-[hsl(var(--accent-hsl))] outline-none transition-colors" 
            placeholder="(555) 000-0000" 
            required 
          />
        </div>

        <!-- Step 3: Location Type -->
        <div class="step-card hidden" data-step="1">
          <span class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent-hsl))]">Question 1 of 8</span>
          <h2 class="font-heading text-2xl md:text-3xl font-semibold text-[hsl(var(--darkAccent-hsl))] mt-2 mb-6">Property Location Type</h2>
          <div class="flex flex-col gap-3">
            {[
              { label: "Downtown Metro", factor: 1.2 },
              { label: "Within City Limits", factor: 1.0 },
              { label: "Surrounding suburbs", factor: 1.1 },
              { label: "Countryside", factor: 0.85 }
            ].map((opt) => (
              <label class="radio-label flex items-center px-5 py-4 rounded-xl border-2 border-black/10 bg-slate-50 hover:bg-white hover:border-[hsl(var(--accent-hsl))] cursor-pointer font-medium transition-all">
                <input type="radio" name="entry.798531007" value={opt.label} data-factor={opt.factor} class="accent-[hsl(var(--accent-hsl))] w-5 h-5 mr-3" required />
                {opt.label}
              </label>
            ))}
          </div>
        </div>

        <!-- Step 4: Condition -->
        <div class="step-card hidden" data-step="2">
          <span class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent-hsl))]">Question 2 of 8</span>
          <h2 class="font-heading text-2xl md:text-3xl font-semibold text-[hsl(var(--darkAccent-hsl))] mt-2 mb-6">Property Condition</h2>
          <div class="flex flex-col gap-3">
            {[
              { label: "Move-in ready", factor: 1.0 },
              { label: "Needs work", factor: 0.85 },
              { label: "Major repairs", factor: 0.70 },
              { label: "Not sure", factor: 0.80 }
            ].map((opt) => (
              <label class="radio-label flex items-center px-5 py-4 rounded-xl border-2 border-black/10 bg-slate-50 hover:bg-white hover:border-[hsl(var(--accent-hsl))] cursor-pointer font-medium transition-all">
                <input type="radio" name="entry.1365799119" value={opt.label} data-factor={opt.factor} class="accent-[hsl(var(--accent-hsl))] w-5 h-5 mr-3" required />
                {opt.label}
              </label>
            ))}
          </div>
        </div>

        <!-- Step 5: Square Footage -->
        <div class="step-card hidden" data-step="3">
          <span class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent-hsl))]">Question 3 of 8</span>
          <h2 class="font-heading text-2xl md:text-3xl font-semibold text-[hsl(var(--darkAccent-hsl))] mt-2 mb-6">Approximate Square Footage</h2>
          <div class="flex flex-col gap-3">
            {[
              { label: "Less than 1,100", base: 180000 },
              { label: "1,200 - 2,200", base: 280000 },
              { label: "2,300 - 4,000", base: 420000 },
              { label: "4,100 +", base: 600000 }
            ].map((opt) => (
              <label class="radio-label flex items-center px-5 py-4 rounded-xl border-2 border-black/10 bg-slate-50 hover:bg-white hover:border-[hsl(var(--accent-hsl))] cursor-pointer font-medium transition-all">
                <input type="radio" name="entry.574954111" value={opt.label} data-base={opt.base} class="accent-[hsl(var(--accent-hsl))] w-5 h-5 mr-3" required />
                {opt.label}
              </label>
            ))}
          </div>
        </div>

        <!-- Step 6: Reason -->
        <div class="step-card hidden" data-step="4">
          <span class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent-hsl))]">Question 4 of 8</span>
          <h2 class="font-heading text-2xl md:text-3xl font-semibold text-[hsl(var(--darkAccent-hsl))] mt-2 mb-6">Reason for Selling</h2>
          <div class="flex flex-col gap-3">
            {["Inherited", "Foreclosure", "Relocating", "Tired of renting it out", "Other"].map((opt) => (
              <label class="radio-label flex items-center px-5 py-4 rounded-xl border-2 border-black/10 bg-slate-50 hover:bg-white hover:border-[hsl(var(--accent-hsl))] cursor-pointer font-medium transition-all">
                <input type="radio" name="entry.513273434" value={opt} class="accent-[hsl(var(--accent-hsl))] w-5 h-5 mr-3" />
                {opt}
              </label>
            ))}
          </div>
        </div>

        <!-- Step 7: Address & Email -->
        <div class="step-card hidden" data-step="5">
          <span class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent-hsl))]">Question 5 of 8</span>
          <h2 class="font-heading text-2xl md:text-3xl font-semibold text-[hsl(var(--darkAccent-hsl))] mt-2 mb-6">Address & Email</h2>
          <div class="flex flex-col gap-4">
            <div>
              <label for="street-address" class="block text-xs font-semibold text-[hsl(var(--darkAccent-hsl))] mb-1">Property Address</label>
              <input 
                type="text" 
                id="street-address"
                name="entry.1974416481" 
                autocomplete="street-address"
                class="w-full px-5 py-4 text-base rounded-xl border-2 border-black/10 bg-slate-50 focus:bg-white focus:border-[hsl(var(--accent-hsl))] outline-none transition-colors" 
                placeholder="123 Main St, City, State" 
                required 
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-[hsl(var(--darkAccent-hsl))] mb-1">Email Address</label>
              <input 
                type="email" 
                id="email"
                name="entry.438778579" 
                autocomplete="email"
                class="w-full px-5 py-4 text-base rounded-xl border-2 border-black/10 bg-slate-50 focus:bg-white focus:border-[hsl(var(--accent-hsl))] outline-none transition-colors" 
                placeholder="name@example.com" 
                required 
              />
            </div>
          </div>
        </div>

        <!-- Step 8: Valuation Result Screen -->
        <div class="step-card hidden" data-step="8">
          <span class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent-hsl))]">Estimated Value</span>
          <h2 class="font-heading text-2xl md:text-3xl font-semibold text-[hsl(var(--darkAccent-hsl))] mt-2 mb-2">Estimated Offer Range</h2>
          <p class="text-sm text-slate-500 mb-6">Based on TN/NC market averages for your property size, location, and condition.</p>
          
          <div class="bg-slate-50 border-2 border-[hsl(var(--accent-hsl))] rounded-2xl p-6 text-center mb-6">
            <span class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Estimated Value</span>
            <div id="estimateDisplay" class="font-heading text-3xl md:text-4xl font-extrabold text-[hsl(var(--darkAccent-hsl))]">
              Calculating...
            </div>
          </div>
        </div>

        <!-- Controls -->
        <div id="formControls" class="flex justify-between items-center mt-8">
          <button 
            type="button" 
            id="prevBtn" 
            class="px-6 py-3 font-semibold text-sm rounded-xl text-[hsl(var(--darkAccent-hsl))] opacity-50 hover:opacity-100 disabled:opacity-20 disabled:cursor-not-allowed transition-all"
            disabled
          >
            Back
          </button>
          <button 
            type="button" 
            id="nextBtn" 
            class="px-7 py-3 font-semibold text-sm rounded-xl bg-[hsl(var(--accent-hsl))] text-[hsl(var(--safeInverseAccent-hsl))] hover:opacity-90 active:scale-[0.98] transition-all"
          >
            Continue
          </button>
        </div>

      </form>
    </div>
  </div>
</section>

<script>
  let currentStep = 1;
  const totalSteps = 8;
  const REDIRECT_URL = "https://www.canvas.homes/formsubmitted";

  const stepCards = document.querySelectorAll('.step-card');
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const progressBar = document.getElementById('progressBar');
  const form = document.getElementById('interactiveForm') as HTMLFormElement;

  function calculateEstimate(): string {
    const sqftRadio = document.querySelector('input[name="entry.574954111"]:checked') as HTMLInputElement;
    const locRadio = document.querySelector('input[name="entry.798531007"]:checked') as HTMLInputElement;
    const condRadio = document.querySelector('input[name="entry.1365799119"]:checked') as HTMLInputElement;

    const baseVal = sqftRadio ? parseFloat(sqftRadio.dataset.base || "250000") : 250000;
    const locFactor = locRadio ? parseFloat(locRadio.dataset.factor || "1.0") : 1.0;
    const condFactor = condRadio ? parseFloat(condRadio.dataset.factor || "1.0") : 1.0;

    const midPoint = baseVal * locFactor * condFactor;
    const lowEnd = Math.round((midPoint * 0.92) / 1000) * 1000 - 30000;
    const highEnd = Math.round((midPoint * 1.08) / 1000) * 1000;

    return `$${lowEnd.toLocaleString()} - $${highEnd.toLocaleString()}`;
  }

  function updateView() {
    stepCards.forEach((card) => {
      const step = parseInt((card as HTMLElement).dataset.step || '0');
      card.classList.toggle('hidden', step !== currentStep);
    });

    prevBtn.disabled = currentStep === 1;

    if (currentStep === totalSteps) {
      nextBtn.innerText = "Submit & Claim Offer";
       nextBtn.className ="animate-pulse px-8 py-2.5 text-sm font-bold rounded-full bg-[hsl(var(--accent-hsl))] text-white hover:opacity-90 active:scale-95 transition-all shadow-sm";
      const displayEl = document.getElementById('estimateDisplay');
      if (displayEl) displayEl.innerText = calculateEstimate();
    } else {
      nextBtn.innerText = "Continue";
      nextBtn.className = "px-6 py-2.5 text-sm font-bold rounded-full bg-primary text-white hover:opacity-90 active:scale-95 transition-all shadow-sm";
}
    }

    if (progressBar) {
      const percentage = ((currentStep - 1) / (totalSteps - 1)) * 100;
      progressBar.style.width = `${percentage}%`;
    }
  

  function validateStep(): boolean {
    const activeCard = document.querySelector(`.step-card[data-step="${currentStep}"]`);
    if (!activeCard) return false;

    const inputs = activeCard.querySelectorAll('input');
    for (let input of inputs) {
      if (input.hasAttribute('required')) {
        if (input.type === 'radio') {
          const radioGroup = activeCard.querySelectorAll(`input[name="${input.name}"]`);
          const isChecked = Array.from(radioGroup).some((r) => (r as HTMLInputElement).checked);
          if (!isChecked) return false;
        } else if (!input.value.trim()) {
          return false;
        }
      }
    }
    return true;
  }

  nextBtn.addEventListener('click', () => {
    if (!validateStep()) {
      alert('Please complete the required field before continuing.');
      return;
    }

    if (currentStep < totalSteps) {
      currentStep++;
      updateView();
    } else {
      form.submit();
      nextBtn.disabled = true;
      nextBtn.innerText = "Submitting...";

      setTimeout(() => {
        window.location.href = REDIRECT_URL;
      }, 300);
    }
  });

  prevBtn.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      updateView();
    }
  });

  form.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      nextBtn.click();
    }
  });

  updateView();
</script>