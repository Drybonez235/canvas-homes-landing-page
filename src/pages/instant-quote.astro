---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalcFormLanding from '../components/CalcFormLanding.astro';
import FooterAstroComponent from '../components/Footer.astro';
import '../styles/global.css';  
---
<BaseLayout
  title="Canvas Homes | Instant Cash Estimate" 
  description="Calculate your home's instant cash value with zero obligations or fees."
  image="favicon.svg"
>
<body class="antialiased selection:bg-[hsl(7,100%,67%)] bg-[hsl(var(--darkAccent-hsl))] font-sans">
 <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K6DN53XZ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-DBR09PJ18P"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-DBR09PJ18P');
</script>

 <CalcFormLanding></CalcFormLanding> 

  <FooterAstroComponent />

</body>
</BaseLayout>